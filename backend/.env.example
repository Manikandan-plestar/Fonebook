# FoneBook Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ─────────────────────────────────────────────────────
# DATABASE — fonebook (main)
# ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=fonebook_app
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_NAME=fonebook

# ─────────────────────────────────────────────────────
# DATABASE — printer_app (secondary, optional)
# ─────────────────────────────────────────────────────
DB1_HOST=localhost
DB1_USER=printer_app_user
DB1_PASS=CHANGE_ME_STRONG_PASSWORD
DB1_NAME=printer_app

# ─────────────────────────────────────────────────────
# EMAIL (Gmail App Password — rotate after removing from git history)
# ─────────────────────────────────────────────────────
GMAIL_USER=otp@tpdirectory.com
GMAIL_PASS=CHANGE_ME_ROTATE_APP_PASSWORD

# ─────────────────────────────────────────────────────
# CORS — comma-separated list of allowed origins
# Native Android/iOS apps send no Origin header, so they always pass.
# ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://apps.plestarinc.com,https://fonebook.app

# ─────────────────────────────────────────────────────
# AUTHENTICATION (Phase 2 — set ENFORCE_AUTH=true after new app rollout)
# ─────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_64_CHARS_MIN
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
ENFORCE_AUTH=false

# ─────────────────────────────────────────────────────
# ADMIN (for /receiveData bulk import — Government contacts)
# ─────────────────────────────────────────────────────
ADMIN_API_KEY=CHANGE_ME_LONG_RANDOM_KEY

# ─────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────
# How many OTP requests per IP per 10 minutes (default: 3)
OTP_RATE_LIMIT_MAX=3
# Global API rate limit per IP per minute (default: 120 — generous for normal use)
GLOBAL_RATE_LIMIT_MAX=120

# ─────────────────────────────────────────────────────
# NODE ENVIRONMENT
# ─────────────────────────────────────────────────────
# Set to 'production' on the server; plain-HTTP fallback is disabled in production.
NODE_ENV=development

# ─────────────────────────────────────────────────────
# Google Play Developer API (Phase 2 — payment server-side verification)
# ─────────────────────────────────────────────────────
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.plestar.fonebook
